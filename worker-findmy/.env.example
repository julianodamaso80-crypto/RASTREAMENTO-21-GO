# Backend do 21 GO
API_BASE_URL=https://api.trackgo.site
API_PREFIX=/api/v1
# JWT de um usuário ADMIN/OPERATOR do tenant (o POST /ble-tags/sightings exige role)
JWT_TOKEN=

# Endpoint Macless Haystack (decifra nada: só busca da Apple)
DECODER_BASE_URL=http://macless-haystack:6176
DECODER_USER=
DECODER_PASS=

# Piso de 1800s aplicado no código: valor menor é ignorado de propósito.
WORKER_INTERVAL_S=1800
LOG_LEVEL=INFO
