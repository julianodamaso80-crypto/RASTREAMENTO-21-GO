generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OPERATOR
  VIEWER
  // CLIENT = dono do veículo. Vê só os veículos vinculados via UserVehicleAccess.
  // Não acessa lista global, alertas de outros, geofences, etc.
  CLIENT
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  DEFAULTING
  BLOCKED
}

enum GeofenceType {
  POLYGON
  CIRCLE
}

/// Tipo do veículo — define o desenho usado no mapa (carro x moto).
enum VehicleType {
  CAR
  MOTORCYCLE
}

enum DeviceModel {
  GT06N
  GT06
  ST310U
  ST340
  ST350
  J16
  J16_PRO
  CRX3
  CRX3_NANO
  CRX_PRO_4G
  TK103
  TK303
  FMB920
  FMB120
  COBAN_GPS103
  CONCOX_GT06N
  SINOTRACK_ST901
  SINOTRACK_ST905
  BLE_KTAG
  BLE_REDTAG
  BLE_AIRTAG_GENERIC
  OTHER
}

enum DeviceStatus {
  PENDING_INSTALL
  INSTALLED
  CONFIGURING
  ONLINE
  OFFLINE
  MAINTENANCE
  DEACTIVATED
}

enum ChipOperator {
  VIVO
  CLARO
  TIM
  OI
  MULTI_OPERATOR
}

enum ApnType {
  PUBLIC
  PRIVATE
}

enum ChipStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
  BLOCKED
  CANCELLED
}

enum CommandType {
  SET_SERVER_IP
  SET_APN
  SET_TIMER
  SET_TIMEZONE
  BLOCK
  UNBLOCK
  RESTART
  GET_LOCATION
  GET_PARAMS
  GET_IMEI
  FACTORY_RESET
  CUSTOM
}

enum CommandStatus {
  PENDING
  SENT
  DELIVERED
  RESPONDED
  FAILED
}

enum AlertType {
  SPEED
  IGNITION_ON
  IGNITION_OFF
  SOS
  BATTERY_LOW
  OFFLINE
  GPS_SILENT
  GEOFENCE_IN
  GEOFENCE_OUT
  POWER_CUT
  JAMMING
  VEHICLE_BATTERY_LOW
  HARSH_BRAKE
  HARSH_ACCEL
  FUEL_THEFT
  MAINTENANCE_DUE
  ENGINE_OVERHEATING
  COLLISION
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum MaintenanceType {
  OIL_CHANGE
  OIL_FILTER
  AIR_FILTER
  FUEL_FILTER
  BELT
  TIRES
  BRAKES
  ALIGNMENT
  BATTERY
  COOLANT
  TRANSMISSION_OIL
  SPARK_PLUG
  GENERAL_REVIEW
  OTHER
}

enum MaintenanceSeverity {
  UPCOMING
  DUE
  OVERDUE
}

enum AlertStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum AlertHistoryAction {
  CREATED
  ASSIGNED
  UNASSIGNED
  COMMENTED
  RESOLVED
  REOPENED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_RESET
  COMMAND_SENT
  OTHER
}

model Tenant {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  slug         String    @unique
  document     String?   @unique
  logoUrl      String?   @map("logo_url")
  primaryColor String    @default("#10b981") @map("primary_color")
  active       Boolean   @default(true)
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  users        User[]
  vehicles     Vehicle[]
  associates   Associate[]
  alerts       Alert[]
  geofences    Geofence[]
  devices      Device[]
  chips        Chip[]
  bleSightings BleSighting[]
  stockItems   StockItem[]
  technicians  Technician[]
  settings     TenantSettings?

  installationPendings InstallationPending[]
  sgaVehicles          SgaVehicle[]
  rdvTags              RdvTag[]
  tagKeys              TagKey[]
  tagPositions         TagPosition[]
  installationRoutes   InstallationRoute[]

  @@map("tenants")
}

/// Pendencia de instalacao espelhada do SGA Hinova.
///
/// A pendencia vive no campo `codigo_tipo_adesao` do veiculo no SGA
/// (GET /tipo-adesao/listar/todos): 1 = PENDENTE INSTALACAO DE RASTREADOR,
/// 10 = PENDENTE INSTALACAO DE TAG. O campo chega em POST /listar/veiculo mas
/// NAO esta na doc oficial - foi confirmado inspecionando a resposta real.
///
/// Esta tabela e um espelho descartavel: cada sync apaga e reescreve as linhas
/// do tenant. Nao substitui Vehicle/Associate - varrer o SGA inteiro pra dentro
/// de Vehicle criaria 22 mil veiculos fantasma (por isso HINOVA_SYNC_ENABLED
/// segue false).
model InstallationPending {
  id                String   @id @default(uuid()) @db.Uuid
  hinovaVehicleCode String   @map("hinova_vehicle_code")
  /// Vazia em veiculo aguardando emplacamento — nesses casos vale o chassi.
  plate             String
  chassi            String?
  /// TRACKER (tipo_adesao 1) ou TAG (tipo_adesao 10).
  pendingType       String   @map("pending_type")
  associateName     String   @map("associate_name")
  associateCode     String   @map("associate_code")
  cpf               String?
  phone             String?
  email             String?
  brandModel        String   @map("brand_model")
  vehicleType       String?  @map("vehicle_type")
  city              String?
  neighborhood      String?
  protectedValue    Decimal  @default(0) @map("protected_value") @db.Decimal(12, 2)
  contractDate      DateTime @map("contract_date") @db.Date
  evaluationTable   String?  @map("evaluation_table")
  consultantName    String?  @map("consultant_name")

  // Endereço + coordenadas pra montar rota. cep/street/number vêm do associado
  // no SGA; lat/lng são geocodificados do CEP (AwesomeAPI) e ficam null até lá.
  cep          String?
  street       String?
  number       String?
  lat          Float?
  lng          Float?

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, hinovaVehicleCode])
  @@index([tenantId, contractDate])
  @@index([tenantId, pendingType])
  @@map("installation_pendings")
}

/// Cache de geocoding por CEP. Endereço não muda, então cada CEP é resolvido uma
/// vez (AwesomeAPI, fallback Nominatim) e reusado por todas as pendências que o
/// compartilham. Não é multi-tenant: coordenada de CEP é fato público.
model CepCoordinate {
  cep       String   @id
  lat       Float
  lng       Float
  source    String   // 'awesomeapi' | 'nominatim'
  createdAt DateTime @default(now()) @map("created_at")

  @@map("cep_coordinates")
}

/// Rota de instalação montada pelo operador e enviada a um técnico.
model InstallationRoute {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  technicianId String   @map("technician_id") @db.Uuid
  technician   Technician @relation(fields: [technicianId], references: [id])
  /// User do painel que montou/enviou.
  assignedById String?  @map("assigned_by_id") @db.Uuid
  /// PENDING | DONE | CANCELLED
  status       String   @default("PENDING")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  stops RouteStop[]

  @@index([tenantId, technicianId, status])
  @@map("installation_routes")
}

/// Parada da rota. Guarda snapshot dos dados no envio — o sync reescreve
/// installation_pendings, então a rota não pode depender daquela linha.
model RouteStop {
  id        String   @id @default(uuid()) @db.Uuid
  routeId   String   @map("route_id") @db.Uuid
  route     InstallationRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  /// Ordem de visita (0-based), já otimizada por vizinho-mais-próximo.
  order     Int
  /// PENDING | DONE | CANCELLED
  status    String   @default("PENDING")
  doneAt    DateTime? @map("done_at")
  /// Motivo quando a parada é cancelada (ex.: pendência saiu do SGA).
  note      String?

  // Snapshot da pendência no momento do envio.
  hinovaVehicleCode String  @map("hinova_vehicle_code")
  plate             String
  pendingType       String  @map("pending_type")
  associateName     String  @map("associate_name")
  phone             String?
  brandModel        String  @map("brand_model")
  street            String?
  number            String?
  neighborhood      String?
  city              String?
  cep               String?
  lat               Float?
  lng               Float?

  @@index([routeId, order])
  @@map("route_stops")
}

model TenantSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  tenantId                  String   @unique @map("tenant_id") @db.Uuid
  speedThresholdKmh         Int      @default(120) @map("speed_threshold_kmh")
  offlineThresholdMinutes   Int      @default(15) @map("offline_threshold_minutes")
  batteryDeviceLowThreshold Int      @default(20) @map("battery_device_low_threshold")
  batteryVehicleLowVolts    Float    @default(11.5) @map("battery_vehicle_low_volts")
  harshBrakeKmhPerSec       Float    @default(-10) @map("harsh_brake_kmh_per_sec")
  harshAccelKmhPerSec       Float    @default(8) @map("harsh_accel_kmh_per_sec")
  fuelDropPercentForTheft   Float    @default(10) @map("fuel_drop_percent_for_theft")
  fuelDropWindowMinutes     Int      @default(5) @map("fuel_drop_window_minutes")
  engineOverheatCelsius     Int      @default(100) @map("engine_overheat_celsius")
  idleSpeedKmh              Int      @default(2) @map("idle_speed_kmh")
  autoBlockOnPowerCut       Boolean  @default(false) @map("auto_block_on_power_cut")
  jammingConfirmReadings    Int      @default(2) @map("jamming_confirm_readings")
  notifyChannels            Json     @default("{\"email\":true,\"push\":true,\"whatsapp\":false}") @map("notify_channels")
  notifyTypes               Json?    @map("notify_types")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  password            String
  name                String
  role                Role      @default(VIEWER)
  active              Boolean   @default(true)
  /// Telas liberadas pra este usuário (chaves de `MANAGEABLE_ROUTES`).
  /// Lista vazia = todas as telas que o `role` já permite (comportamento antigo).
  allowedRoutes       String[]  @default([]) @map("allowed_routes")
  traccarUserId       Int?      @map("traccar_user_id")
  tenantId            String    @map("tenant_id") @db.Uuid
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  vehicleAccess UserVehicleAccess[]

  @@index([tenantId, deletedAt])
  @@map("users")
}

/// Liga User (geralmente role=CLIENT) aos Vehicles que ele tem permissão de ver.
/// Modelagem N:N pra suportar família com múltiplos carros + cliente que vendeu
/// um veículo manter histórico só nos que ainda possui.
model UserVehicleAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
  @@index([vehicleId])
  @@map("user_vehicle_access")
}

model Vehicle {
  id              String        @id @default(uuid()) @db.Uuid
  plate           String
  vehicleType     VehicleType   @default(CAR) @map("vehicle_type")
  brand           String?
  model           String?
  year            Int?
  color           String?
  chassi          String?
  renavam         String?
  uniqueId        String        @unique @map("unique_id")
  traccarDeviceId Int?          @map("traccar_device_id")
  status          VehicleStatus @default(ACTIVE)
  tenantId        String        @map("tenant_id") @db.Uuid
  associateId     String?       @map("associate_id") @db.Uuid
  hinovaCode      String?       @map("hinova_code")
  lastSync        DateTime?     @map("last_sync")

  /// Situação financeira espelhada do SGA: ADIMPLENTE | INADIMPLENTE. Null =
  /// nunca consultada. Vem do lookup por placa (no vínculo e no cron diário) ou
  /// de override manual do operador.
  financialStatus   String?   @map("financial_status")
  financialStatusAt DateTime? @map("financial_status_at")
  /// Descrição da situação do veículo no SGA (ATIVO, CANCELADO, SUBSTITUIDO...).
  /// É o que o card estampa ao lado do código — o `status` acima é o nosso.
  sgaStatusLabel    String?   @map("sga_status_label")
  /// Corta o acesso do associado a ESTE ativo no app, sem mexer na senha nem
  /// nos outros veículos dele.
  appAccessBlocked  Boolean   @default(false) @map("app_access_blocked")

  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  associate        Associate?          @relation(fields: [associateId], references: [id])
  alerts           Alert[]
  geofenceVehicles GeofenceVehicle[]
  device           Device?
  userAccess       UserVehicleAccess[]
  maintenancePlans MaintenancePlan[]
  scores           VehicleScore[]

  @@unique([plate, tenantId])
  @@map("vehicles")
}

model MaintenancePlan {
  id                  String               @id @default(uuid()) @db.Uuid
  vehicleId           String               @map("vehicle_id") @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  type                MaintenanceType
  name                String
  intervalKm          Int?                 @map("interval_km")
  intervalEngineHours Int?                 @map("interval_engine_hours")
  intervalMonths      Int?                 @map("interval_months")
  lastDoneAt          DateTime?            @map("last_done_at")
  lastDoneKm          Float?               @map("last_done_km")
  lastDoneEngineHours Float?               @map("last_done_engine_hours")
  active              Boolean              @default(true)
  severity            MaintenanceSeverity?
  deletedAt           DateTime?            @map("deleted_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, deletedAt])
  @@index([vehicleId, active])
  @@map("maintenance_plans")
}

model VehicleScore {
  id          String   @id @default(uuid()) @db.Uuid
  vehicleId   String   @map("vehicle_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  totalScore  Int      @map("total_score")
  breakdown   Json
  kmAnalyzed  Float    @default(0) @map("km_analyzed")
  createdAt   DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, periodEnd])
  @@index([tenantId, periodEnd(sort: Desc)])
  @@map("vehicle_scores")
}

model AssistantConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages AssistantMessage[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String
  content        String
  toolCalls      Json?    @map("tool_calls")
  tokenUsage     Json?    @map("token_usage")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

model Associate {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  cpf         String
  rg          String?
  birthDate   DateTime? @map("birth_date")
  phone       String?
  email       String?
  tenantId    String    @map("tenant_id") @db.Uuid
  hinovaCode  String?   @map("hinova_code")
  // Auth do app do associado. Nullable: no primeiro acesso o associado entra com
  // CPF como login E senha; a partir daí o hash aqui é a única senha válida.
  password    String?
  /// Primeiro acesso feito com o CPF ainda não trocado pela senha do cliente.
  /// Enquanto true o app obriga a definir senha própria antes de usar.
  mustChangePassword Boolean @default(true) @map("must_change_password")
  lastLoginAt DateTime? @map("last_login_at")

  // --- Recuperação de senha por código enviado no WhatsApp ---
  /// Hash do código de 6 dígitos (nunca o código em texto puro).
  resetCodeHash      String?   @map("reset_code_hash")
  resetCodeExpiresAt DateTime? @map("reset_code_expires_at")
  /// Tentativas erradas de digitar o código. Estoura o limite, o código morre.
  resetCodeAttempts  Int       @default(0) @map("reset_code_attempts")
  /// Quando o último código foi enviado — base do limite de envios por hora.
  resetCodeSentAt    DateTime? @map("reset_code_sent_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  vehicles Vehicle[]

  @@index([tenantId, deletedAt])
  @@index([cpf])
  @@map("associates")
}

/// Técnico instalador. Auth própria por CPF + senha (JWT type: 'technician'),
/// isolada do User do painel e do Associate do app — técnico nunca acessa o painel.
model Technician {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  cpf                 String
  phone               String?
  email               String?
  canReceiveEquipment Boolean   @default(true) @map("can_receive_equipment")
  active              Boolean   @default(true)
  // Nullable: técnico só loga depois que a senha provisória é gerada.
  password            String?
  mustChangePassword  Boolean   @default(true) @map("must_change_password")
  lastLoginAt         DateTime? @map("last_login_at")
  tenantId            String    @map("tenant_id") @db.Uuid
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  stockItems StockItem[]
  devices    Device[]
  routes     InstallationRoute[]

  @@unique([tenantId, cpf])
  @@index([tenantId, deletedAt])
  @@map("technicians")
}

model Alert {
  id           String        @id @default(uuid()) @db.Uuid
  type         AlertType
  severity     AlertSeverity @default(INFO)
  message      String
  data         Json?
  read         Boolean       @default(false)
  status       AlertStatus   @default(OPEN)
  assignedToId String?       @map("assigned_to_id") @db.Uuid
  assignedAt   DateTime?     @map("assigned_at")
  resolvedById String?       @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?     @map("resolved_at")
  resolution   String?
  vehicleId    String        @map("vehicle_id") @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  deletedAt    DateTime?     @map("deleted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  vehicle Vehicle        @relation(fields: [vehicleId], references: [id])
  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  history AlertHistory[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([assignedToId, status])
  @@map("alerts")
}

model AlertHistory {
  id        String             @id @default(uuid()) @db.Uuid
  alertId   String             @map("alert_id") @db.Uuid
  userId    String?            @map("user_id") @db.Uuid
  userEmail String?            @map("user_email")
  action    AlertHistoryAction
  comment   String?
  metadata  Json?
  createdAt DateTime           @default(now()) @map("created_at")

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt(sort: Desc)])
  @@map("alert_history")
}

model Geofence {
  id                String       @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  type              GeofenceType
  coordinates       Json
  color             String       @default("#3b82f6")
  active            Boolean      @default(true)
  traccarGeofenceId Int?         @map("traccar_geofence_id")
  tenantId          String       @map("tenant_id") @db.Uuid
  deletedAt         DateTime?    @map("deleted_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  geofenceVehicles GeofenceVehicle[]

  @@index([tenantId, deletedAt])
  @@map("geofences")
}

model GeofenceVehicle {
  id         String   @id @default(uuid()) @db.Uuid
  geofenceId String   @map("geofence_id") @db.Uuid
  vehicleId  String   @map("vehicle_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  geofence Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([geofenceId, vehicleId])
  @@map("geofence_vehicles")
}

model Device {
  id              String       @id @default(uuid()) @db.Uuid
  imei            String       @unique
  model           DeviceModel
  brand           String?
  firmwareVersion String?      @map("firmware_version")
  serialNumber    String?      @map("serial_number")
  traccarDeviceId Int?         @map("traccar_device_id")
  status          DeviceStatus @default(PENDING_INSTALL)
  chipId          String?      @unique @map("chip_id") @db.Uuid
  chip            Chip?        @relation(fields: [chipId], references: [id])
  vehicleId       String?      @unique @map("vehicle_id") @db.Uuid
  vehicle         Vehicle?     @relation(fields: [vehicleId], references: [id])
  tenantId        String       @map("tenant_id") @db.Uuid
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  installedAt     DateTime?    @map("installed_at")
  installedBy     String?      @map("installed_by")
  // Técnico que executou a instalação. `installedBy` (texto) fica pro histórico
  // anterior ao cadastro de técnicos; este campo é o que sustenta a contagem.
  installedByTechnicianId String?     @map("installed_by_technician_id") @db.Uuid
  installedByTechnician   Technician? @relation(fields: [installedByTechnicianId], references: [id])
  installLocation String?      @map("install_location")
  // Conferência de GPS no ato da instalação: prova de que a posição reportada
  // pelo rastreador batia com o lugar onde o técnico estava. Ver P0.2 do plano.
  installCheckFixTime   DateTime? @map("install_check_fix_time")
  installCheckLat       Float?    @map("install_check_lat")
  installCheckLng       Float?    @map("install_check_lng")
  /// Distância em metros entre o rastreador e o técnico no momento do aceite.
  installCheckDistanceM Int?      @map("install_check_distance_m")
  // Retirada do rastreador (desinstalação). Mantém o histórico do device.
  uninstalledAt   DateTime?    @map("uninstalled_at")
  uninstalledBy   String?      @map("uninstalled_by")
  uninstallReason String?      @map("uninstall_reason")
  lastConnection  DateTime?    @map("last_connection")
  /// Chave privada da etiqueta BLE (base64). Segredo operacional: permite
  /// decifrar a posição da TAG na rede Find My. Nunca sai em listagem.
  bleAdvKeyPrivate String?   @map("ble_adv_key_private")
  /// SHA-256 da advertisement key (base64), usado para casar o relatório.
  bleAdvKeyHashed  String?   @map("ble_adv_key_hashed")
  /// Enquanto estiver no futuro, a TAG é consultada em ritmo acelerado.
  bleTurboUntil    DateTime? @map("ble_turbo_until")
  notes           String?
  deletedAt       DateTime?    @map("deleted_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  smsCommands  SmsCommand[]
  bleSightings BleSighting[]

  @@index([tenantId, status])
  @@map("devices")
}

/// Histórico de posições reportadas pelos rastreadores. Persistência seletiva
/// (ver PositionsService.persistIfRelevant): mudança de ignição, alarmes,
/// velocidade alta, atributos críticos (powerCut, jamming) sempre persistem;
/// ponto parado faz throttle de 1/min.
/// Em produção, particionar por mês via SQL puro (Prisma não gera partição).
model Position {
  id                String   @id @default(uuid()) @db.Uuid
  vehicleId         String   @map("vehicle_id") @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  traccarPositionId Int?     @map("traccar_position_id")
  deviceTime        DateTime @map("device_time")
  /// Momento em que o GPS efetivamente obteve o fix. É o único carimbo de tempo
  /// que prova "o veículo estava AQUI neste instante" — `deviceTime` e
  /// `serverTime` podem avançar em keep-alive sem fix novo. Nullable só pro
  /// histórico anterior à migração.
  fixTime           DateTime? @map("fix_time")
  /// Falso quando o Traccar marcou a posição como inválida/aproximada (LBS por
  /// torre de celular, erro de quilômetros). Nunca deve ser exibida como
  /// localização real — ver docs/PLANO-PRODUCAO-ZERO-ERRO.md P0.1.
  valid             Boolean  @default(true)
  serverTime        DateTime @default(now()) @map("server_time")
  latitude          Float
  longitude         Float
  speed             Float
  course            Float?
  altitude          Float?
  accuracy          Float?
  address           String?
  ignition          Boolean?
  batteryLevel      Int?     @map("battery_level")
  powerVolts        Float?   @map("power_volts")
  rpm               Int?
  fuel              Float?
  temperature       Float?
  odometer          Float?
  gsmSignal         Int?     @map("gsm_signal")
  satellites        Int?
  powerCut          Boolean  @default(false) @map("power_cut")
  jamming           Boolean  @default(false)
  vibration         Boolean  @default(false)
  jarring           Boolean  @default(false)
  charging          Boolean  @default(false)
  alarm             String?
  rawAttributes     Json?    @map("raw_attributes")

  /// Um id de posição do Traccar nunca entra duas vezes. NULLs não colidem no
  /// Postgres, então posições sem id do Traccar seguem livres. Protege contra a
  /// reemissão do estado atual que o Traccar faz a cada reconexão do WebSocket.
  @@unique([traccarPositionId])
  @@index([vehicleId, deviceTime(sort: Desc)])
  @@index([tenantId, deviceTime(sort: Desc)])
  @@index([vehicleId, powerCut, deviceTime(sort: Desc)])
  @@index([vehicleId, jamming, deviceTime(sort: Desc)])
  @@map("positions")
}

model BleSighting {
  id            String   @id @default(uuid()) @db.Uuid
  deviceId      String   @map("device_id") @db.Uuid
  device        Device   @relation(fields: [deviceId], references: [id])
  macAddress    String   @map("mac_address")
  /// Nulo em relatório da rede Apple: a posição vem do iPhone que ouviu, não
  /// da potência do sinal.
  rssi          Int?
  /// Raio de confiança em metros informado pela rede Find My.
  accuracy      Int?
  hashedAdvKey  String?  @map("hashed_adv_key")
  counterByte   Int?     @map("counter_byte")
  scannerLat    Float?   @map("scanner_lat")
  scannerLng    Float?   @map("scanner_lng")
  scannerSource String?  @map("scanner_source")
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  /// Momento em que a TAG foi vista. É o carimbo que vale para decidir onde o
  /// veículo está — `createdAt` é apenas quando gravamos.
  seenAt        DateTime @default(now()) @map("seen_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([deviceId, createdAt(sort: Desc)])
  @@index([deviceId, seenAt(sort: Desc)])
  @@map("ble_sightings")
}

model Chip {
  id          String       @id @default(uuid()) @db.Uuid
  iccid       String       @unique
  phoneNumber String?      @map("phone_number")
  operator    ChipOperator
  apn         String
  apnUser     String?      @map("apn_user")
  apnPassword String?      @map("apn_password")
  apnType     ApnType      @default(PRIVATE) @map("apn_type")
  dataPlanMb  Int          @default(50) @map("data_plan_mb")
  provider    String?
  status      ChipStatus   @default(ACTIVE)
  activatedAt DateTime?    @map("activated_at")
  expiresAt   DateTime?    @map("expires_at")
  device      Device?
  tenantId    String       @map("tenant_id") @db.Uuid
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("chips")
}

/// Estoque de rastreadores importado via planilha (IMEI + chip/linha + operadora + status + server).
/// Chave de deduplicação: (tenantId, imei) — reimportar atualiza em vez de duplicar.
model StockItem {
  id           String    @id @default(uuid()) @db.Uuid
  imei         String
  iccid        String?
  line         String?
  operator     String?
  status       String?
  server       String?
  registeredAt DateTime? @map("registered_at")
  activatedAt  DateTime? @map("activated_at")
  notes        String?
  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  // Associação: quando o rastreador é vinculado a um cliente/veículo, sai do
  // estoque disponível (a listagem filtra associatedAt: null) e vira Device.
  associatedAt DateTime? @map("associated_at")
  deviceId     String?   @unique @map("device_id") @db.Uuid
  // Reserva pro login do técnico. Escalar (não N:N) porque um equipamento nunca
  // pode estar em dois logins ao mesmo tempo.
  assignedTechnicianId String?     @map("assigned_technician_id") @db.Uuid
  assignedTechnician   Technician? @relation(fields: [assignedTechnicianId], references: [id])
  assignedAt           DateTime?   @map("assigned_at")
  assignedById         String?     @map("assigned_by_id") @db.Uuid
  // Device correspondente no Traccar. O estoque inteiro é cadastrado lá pra que
  // dê pra conferir a instalação ANTES de vincular no SGA — sem device, o
  // Traccar descarta o que o rastreador manda.
  traccarDeviceId      Int?        @map("traccar_device_id")
  // Selo da conferência de instalação. Informativo: não bloqueia o vínculo.
  // `validationSnapshot` guarda o retrato da telemetria no momento do aceite
  // (voltagem, ignição, satélites, coordenada, motivos) — é o que responde,
  // meses depois, como o rastreador estava no dia da entrega.
  validatedAt          DateTime?   @map("validated_at")
  validatedById        String?     @map("validated_by_id") @db.Uuid
  validatedByName      String?     @map("validated_by_name")
  validationOk         Boolean?    @map("validation_ok")
  validationNotes      String?     @map("validation_notes")
  validationSnapshot   Json?       @map("validation_snapshot")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, imei])
  @@index([tenantId, status])
  @@index([tenantId, assignedTechnicianId])
  @@map("stock_items")
}

model SmsCommand {
  id          String        @id @default(uuid()) @db.Uuid
  deviceId    String        @map("device_id") @db.Uuid
  device      Device        @relation(fields: [deviceId], references: [id])
  command     String
  type        CommandType
  status      CommandStatus @default(PENDING)
  sentAt      DateTime?     @map("sent_at")
  response    String?
  respondedAt DateTime?     @map("responded_at")
  sentBy      String        @map("sent_by")
  tenantId    String        @map("tenant_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([deviceId, createdAt(sort: Desc)])
  @@map("sms_commands")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String?     @map("tenant_id") @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  userEmail  String?     @map("user_email")
  action     AuditAction
  entity     String?
  entityId   String?     @map("entity_id")
  method     String
  path       String
  statusCode Int         @map("status_code")
  ip         String?
  userAgent  String?     @map("user_agent")
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Endereço de uma coordenada, resolvido sob demanda e guardado pra sempre.
///
/// A coordenada entra arredondada a 3 casas (~110 m): o mesmo quarteirão
/// reaproveita o endereço, o que faz o rastreador em movimento também ter rua
/// na tela, e o Nominatim (1 req/s por política do OSM) não vira gargalo. Sem
/// `tenantId` de propósito — rua é rua, o dado não pertence a ninguém e o
/// cache aproveita entre empresas.
model GeoAddress {
  id        String   @id @default(uuid()) @db.Uuid
  latKey    Float    @map("lat_key")
  lngKey    Float    @map("lng_key")
  /// Coordenada que foi de fato geocodificada. A chave acima é só o índice da
  /// célula; é esta que diz a que distância do ponto pedido o endereço vale.
  lat       Float?
  lng       Float?
  address   String
  provider  String   @default("nominatim")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([latKey, lngKey])
  @@map("geo_addresses")
}

/// Espelho cadastral do SGA: TODO veículo, em qualquer situação.
///
/// Existe porque o SGA não tem busca por placa: o único GET que aceita placa é
/// o /buscar/situacao-financeira-veiculo, que é financeiro e responde 406
/// enquanto o veículo não tem boleto emitido — exatamente o veículo recém-vendido
/// que está indo receber rastreador. Sem este espelho, a instalação depende de
/// ter boleto, o que não é regra de negócio nenhuma.
///
/// Alimentado pela mesma varredura do InstallationPending (POST /listar/veiculo),
/// que já lê a base inteira e hoje descarta o que não é pendência.
model SgaVehicle {
  id                String @id @default(uuid()) @db.Uuid
  hinovaVehicleCode String @map("hinova_vehicle_code")

  /// Vazia em veículo aguardando emplacamento — nesses casos vale o chassi.
  plate  String
  chassi String?

  associateName String  @map("associate_name")
  associateCode String  @map("associate_code")
  cpf           String?
  phone         String?
  email         String?
  brandModel    String  @map("brand_model")

  /// 1 ATIVO · 2 INATIVO · 3 PENDENTE · 4 INADIMPLENTE · 5 NEGADO
  /// (verificado na API real em 2026-08-19).
  situationCode  String  @map("situation_code")
  situationLabel String  @map("situation_label")
  /// codigo_tipo_adesao: 1 pendente rastreador · 2 instalado · 10 pendente TAG…
  adhesionCode   String? @map("adhesion_code")
  /// `tipo` do SGA, cru: "MOTOCICLETA (ATé 400CC)", "VEICULOS LEVES"… É daqui
  /// que sai `Vehicle.vehicleType` (carro x moto) — ver tipoVeiculoDoSga().
  vehicleType    String? @map("vehicle_type")

  contractDate DateTime? @map("contract_date") @db.Date

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, hinovaVehicleCode])
  @@index([tenantId, plate])
  @@index([tenantId, chassi])
  @@index([tenantId, situationCode])
  @@map("sga_vehicles")
}

/// Espelho da TAG que roda na RedeVeiculos (plataforma incumbente).
///
/// Não é `Device` de propósito: `Device.vehicleId` é `@unique`, e 8.812 das
/// TAGs ativas estão em veículo que também tem rastreador — cadastrá-las como
/// Device desvincularia o rastreador desses veículos. Ver a migration
/// `20260827150000_espelho_tag_redeveiculos` e a memória `reference_tag_ativa_regra`.
model RdvTag {
  id String @id @default(uuid()) @db.Uuid

  /// Número de série da TAG na origem (lá aparece no campo "Imei", mas TAG não
  /// tem IMEI — não confundir com o IMEI do rastreador do mesmo veículo).
  tagIdentifier String  @map("tag_identifier")
  plate         String
  chassi        String?
  /// Rótulo cru da origem: REDETAG · KTAG · WGPSTAG · TAG-GT06.
  tagModel      String? @map("tag_model")

  /// Última posição conhecida. NUNCA é tempo real — a TAG só é vista quando
  /// alguém passa perto dela. `seenAt` é o carimbo que vale e a tela mostra a
  /// idade dele sempre. Ver `feedback_rastreamento_realtime_sem_heartbeat`.
  lastLat Float?    @map("last_lat")
  lastLng Float?    @map("last_lng")
  seenAt  DateTime? @map("seen_at")

  /// `id_ativo` na origem: reconcilia sem depender da placa.
  sourceAssetId String? @map("source_asset_id")
  source        String  @default("REDEVEICULOS")

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, tagIdentifier])
  @@index([tenantId, plate])
  @@index([tenantId, seenAt(sort: Desc)])
  @@map("rdv_tags")
}

/// Chave de uma TAG, como o fabricante entrega no `.xlsx` por lote.
///
/// É o que torna o rastreamento NOSSO: com a chave privada nós mesmos pedimos
/// os relatórios à rede Find My e abrimos o envelope. Sem ela, o número de
/// série não serve para nada — a consulta é feita pelo hash, e a resposta só
/// abre com a privada.
///
/// Fica numa tabela própria, sem relação obrigatória com Device ou Vehicle, de
/// propósito: a chave existe desde a compra do lote, muito antes de a TAG ser
/// instalada em algum veículo.
model TagKey {
  id String @id @default(uuid()) @db.Uuid

  /// Número impresso na TAG (coluna SN do arquivo do fabricante).
  serialNumber String  @map("serial_number")
  macAddress   String? @map("mac_address")

  /// Segredo operacional: NUNCA sai em resposta de API. Só o coletor lê.
  privateKey String @map("private_key")
  /// SHA-256 da advertisement key: é por ele que se pergunta à Apple.
  hashedAdvKey String @map("hashed_adv_key")

  /// Lote de compra (os 6 primeiros dígitos do SN), para saber de qual arquivo
  /// veio e o que ainda falta pedir ao fabricante.
  batch String?

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, serialNumber])
  @@index([tenantId, hashedAdvKey])
  @@index([tenantId, batch])
  @@map("tag_keys")
}

/// Histórico de onde cada TAG foi vista. Um ponto por avistamento, para sempre.
///
/// Diferente de `rdv_tags`, que guarda UMA linha por TAG e é sobrescrita a cada
/// sincronização: aqui nada é sobrescrito, e é disso que nascem o rastro e a
/// análise de padrão.
///
/// `source` existe para o dia em que a RedeVeiculos for cortada: quando o
/// coletor próprio assumir, ele grava nesta mesma tabela com
/// `source = 'APPLE_FINDMY'` e nenhuma tela precisa mudar.
model TagPosition {
  id String @id @default(uuid()) @db.Uuid

  /// Número da TAG. Não é chave estrangeira de propósito: chega posição de TAG
  /// cuja chave ainda não temos, e perder o ponto seria pior.
  serialNumber String  @map("serial_number")
  /// Placa do veículo no momento do avistamento, quando conhecida.
  plate        String?

  latitude  Float
  longitude Float
  /// Raio de confiança em metros informado pela rede.
  accuracyM Int? @map("accuracy_m")

  /// Quando a TAG foi vista. É o carimbo que vale.
  seenAt     DateTime @map("seen_at")
  /// Quando nós soubemos. A diferença para `seenAt` é a idade do dado, e é ela
  /// que impede a tela de apresentar isso como posição do momento.
  receivedAt DateTime @default(now()) @map("received_at")

  /// APPLE_FINDMY (coletor próprio) · ESPELHO_RDV (plataforma de origem).
  source String

  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  /// O mesmo avistamento nunca entra duas vezes, mesmo que a coleta repita a
  /// janela — o que acontece sempre, porque a Apple devolve 7 dias a cada
  /// consulta.
  @@unique([tenantId, serialNumber, seenAt])
  @@index([tenantId, serialNumber, seenAt(sort: Desc)])
  @@index([tenantId, plate, seenAt(sort: Desc)])
  @@index([tenantId, seenAt(sort: Desc)])
  @@map("tag_positions")
}
