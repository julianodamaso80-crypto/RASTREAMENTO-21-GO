# Backend
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rastreamento21go
REDIS_URL=redis://localhost:6379

# Traccar
TRACCAR_URL=http://localhost:8082
TRACCAR_API_URL=http://localhost:8082/api
TRACCAR_ADMIN_EMAIL=admin@rastreamento21go.com.br
TRACCAR_ADMIN_PASSWORD=admin123

# Hinova SGA
HINOVA_BASE_URL=https://api.hinova.com.br/api/sga/v2
HINOVA_MOCK=true
HINOVA_SYNC_INTERVAL=21600000

# JWT
# Segredo do mundo interno (painel + PWA do técnico). Mín. 32 chars em produção.
JWT_SECRET=dev-secret-change-in-production
# Validade do token do app do cliente final.
JWT_EXPIRATION=24h
# Segredo SÓ do app do associado. Tem que ser DIFERENTE do JWT_SECRET — é isso
# que torna um token de cliente matematicamente inválido no painel interno.
JWT_ASSOCIATE_SECRET=dev-associate-secret-change-in-production
# Validade do token do time interno — mais curta que a do cliente de propósito.
JWT_INTERNAL_EXPIRATION=12h
# 'true' passa a EXIGIR o campo `type` no token; vira true 24h após o deploy,
# quando todo token legado (sem type) já expirou.
JWT_REQUIRE_TYPE=false

# Geocoder self-hosted (traccar-geocoder) — reverse geocoding sem o limite de
# 1 req/s do Nominatim público. Com as DUAS vazias, ou se o próprio falhar em
# runtime, o serviço cai no Nominatim de sempre. Ver docs/RUNBOOK-GEOCODER.md.
# Em dev o backend roda no host (fora da rede do docker compose) — "geocoder"
# não resolve. Valor que funciona localmente: http://localhost:3011
# A key não é algo que você define aqui: ela é criada dentro do dashboard do
# próprio geocoder (abra http://localhost:3011 e faça o primeiro login/token).
# NUNCA cole uma key real neste arquivo.
GEOCODER_URL=
GEOCODER_API_KEY=

# Servidores de Rastreamento (DNS hostname preferencial, IP como fallback)
# 2 servidores: primário (SERVER,1) e backup (SERVER,2) — failover automático no rastreador
SERVER_HOSTNAME=gps1.trackgo.site
SERVER_HOSTNAME_BACKUP=gps2.trackgo.site
SERVER_PRIMARY_IP=0.0.0.0
SERVER_SECONDARY_IP=0.0.0.0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_TRACCAR_URL=http://localhost:8082
